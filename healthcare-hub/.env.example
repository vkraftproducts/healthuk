# Copy to .env (repo root) for local development. Every dev script loads it automatically;
# a variable already set in your shell wins. Never commit real secrets.
NODE_ENV=development

# Postgres from docker-compose (superuser postgres/postgres). `pnpm db:bootstrap` creates these
# two roles with the passwords below and gives the migrator the `hub` database.
# App role (not owner; subject to FORCE ROW LEVEL SECURITY)
DATABASE_URL=postgresql://hub_app:hub_app_dev@localhost:5432/hub
# Migrator/owner role (migrations, seed and tests only)
DATABASE_ADMIN_URL=postgresql://hub_migrator:hub_migrator_dev@localhost:5432/hub
# Worker queue (pg-boss creates and owns its own `pgboss` schema; not the app role).
QUEUE_DATABASE_URL=postgresql://hub_migrator:hub_migrator_dev@localhost:5432/hub
# Only needed if your Postgres superuser is not postgres/postgres on localhost:5432
# DATABASE_SUPERUSER_URL=postgresql://postgres:postgres@localhost:5432/postgres
# TEST_SUPERUSER_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Auth: dev mock OIDC on :4010 (refuses to start in production)
OIDC_ISSUER=http://localhost:4010
OIDC_AUDIENCE=healthcare-hub-api
OIDC_JWKS_URI=http://localhost:4010/.well-known/jwks.json

# Sign-in mode: dev (mock OIDC, default), local (username + password run by the API, ADR 0006),
# entra. Set VITE_AUTH_MODE to the same value for the web. Local mode keeps the session in an
# HttpOnly refresh cookie (30 min idle, 12 h at most). The cookie is marked Secure when
# PUBLIC_API_URL is https or NODE_ENV=production, and the web and API must be on the same site.
# LOCAL_AUTH_PRIVATE_KEY (PKCS#8 PEM, EC P-256 or RSA) is required for local mode in production.
# AUTH_MODE=local
# VITE_AUTH_MODE=local
# LOCAL_AUTH_PRIVATE_KEY=
# Local development only (refused in production): privileged roles skip the authenticator code.
# DEV_DISABLE_MFA=true

API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Crew push in development is logged, not sent.
PUSH_PROVIDER=log

# Escalation email and push (worker). `outbox` records only; production refuses it.
# EMAIL_TRANSPORT=smtp needs SMTP_URL (Mailpit from docker compose: smtp://localhost:1025).
EMAIL_TRANSPORT=outbox
# SMTP_URL=smtp://localhost:1025
# EMAIL_FROM=Healthcare Hub <no-reply@example.test>
# PUSH_TRANSPORT: outbox, or expo and/or webpush (comma-separated, e.g. expo,webpush).
PUSH_TRANSPORT=outbox
# Web Push VAPID keys (base64url P-256; e.g. `npx web-push generate-vapid-keys`) and contact.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.test

# IP_HASH_SECRET, BLOB_SIGNING_SECRET and FIELD_ENCRYPTION_KEY have development defaults and are
# refused in production. EVIDENCE_DIR defaults to apps/api/.data/evidence for both API and worker.

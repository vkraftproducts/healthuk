{
  "name": "@hub/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hub/config": "workspace:*",
    "@hub/db": "workspace:*",
    "@hub/domain": "workspace:*",
    "pg-boss": "12.37.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}

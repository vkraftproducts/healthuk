{
  "name": "@hub/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "dev:oidc": "tsx --env-file-if-exists=../../.env scripts/mock-oidc.ts",
    "demo:crew": "tsx --env-file-if-exists=../../.env scripts/crew-demo.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@hub/config": "workspace:*",
    "@hub/contracts": "workspace:*",
    "@hub/db": "workspace:*",
    "@hub/domain": "workspace:*",
    "@hub/rules": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-fastify": "12.3.2",
    "fastify": "5.12.7",
    "jose": "6.2.14",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "fflate": "0.8.2",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}

{
  "name": "@hub/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "e2e": "maestro test .maestro"
  },
  "dependencies": {
    "@hub/contracts": "workspace:*",
    "@hub/rules": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "58.0.14",
    "expo-application": "58.1.2",
    "expo-auth-session": "58.0.13",
    "expo-constants": "58.0.12",
    "expo-crypto": "58.0.7",
    "expo-device": "58.0.5",
    "expo-file-system": "58.0.9",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.13",
    "expo-local-authentication": "58.0.2",
    "expo-notifications": "58.1.5",
    "expo-screen-capture": "58.0.5",
    "expo-secure-store": "58.0.2",
    "expo-sqlite": "58.0.13",
    "expo-status-bar": "58.0.3",
    "expo-web-browser": "58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1"
  },
  "devDependencies": {
    "@hub/config": "workspace:*",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.17",
    "jest": "30.5.2",
    "jest-expo": "58.0.11",
    "test-renderer": "1.3.1",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/test/setup.ts"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|expo-.*|@hub/.*|react-native-safe-area-context))"
    ]
  }
}

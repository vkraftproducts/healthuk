{
  "name": "@hub/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./raw": {
      "types": "./dist/raw.d.ts",
      "default": "./dist/raw.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "bootstrap": "tsx --env-file-if-exists=../../.env scripts/bootstrap.ts",
    "migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "seed:sectors": "tsx --env-file-if-exists=../../.env scripts/seed-sectors.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "drill": "tsx --env-file-if-exists=../../.env scripts/restore-drill.ts"
  },
  "dependencies": {
    "@hub/config": "workspace:*",
    "@hub/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.1",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}

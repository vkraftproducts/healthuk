// Typed client only. The database is created by sql/migrations/*.sql (RLS, triggers,
// exclusion constraints). Keep this file in sync by hand when a migration changes a table.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEAVER

  @@map("user_status")
}

enum LocationType {
  PATIENT_FACING
  ADMIN_ONLY

  @@map("location_type")
}

enum DevicePlatform {
  IOS
  ANDROID

  @@map("device_platform")
}

enum ActorType {
  USER
  SYSTEM
  SUPPORT

  @@map("actor_type")
}

model Organisation {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name        String
  sectorPacks String[]  @default([]) @map("sector_packs")
  regulator   String    @default("CQC")
  timezone    String    @default("Europe/London")
  settings    Json      @default("{}")
  version     Int       @default(1)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid

  locations   Location[]
  memberships Membership[]
  services    ServiceType[]
  activities  RegisteredActivity[]

  @@map("organisation")
}

model Location {
  id             String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  name           String
  address        Json         @default("{}")
  type           LocationType @default(PATIENT_FACING)
  registered     Boolean      @default(false)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?      @map("updated_by") @db.Uuid

  organisation Organisation         @relation(fields: [organisationId], references: [id])
  memberships  Membership[]
  activities   RegisteredActivity[]

  @@index([organisationId, name])
  @@map("location")
}

model AppUser {
  id                String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  idpSubject        String?    @unique @map("idp_subject")
  email             String     @unique
  displayName       String     @map("display_name")
  status            UserStatus @default(INVITED)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  isPlatformSupport Boolean    @default(false) @map("is_platform_support")
  version           Int        @default(1)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?    @map("created_by") @db.Uuid
  updatedAt         DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?    @map("updated_by") @db.Uuid

  memberships    Membership[]
  deviceSessions DeviceSession[]

  @@map("app_user")
}

model Permission {
  key         String @id
  description String @default("")

  rolePermissions RolePermission[]

  @@map("permission")
}

model Role {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  key            String
  name           String
  derivedFrom    String?  @map("derived_from")
  isSystem       Boolean  @default(false) @map("is_system")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?  @map("updated_by") @db.Uuid

  rolePermissions RolePermission[]
  memberships     Membership[]

  @@map("role")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@map("role_permission")
}

model Membership {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  locationId     String?   @map("location_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  validFrom      DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo        DateTime? @map("valid_to") @db.Timestamptz(6)
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?   @map("updated_by") @db.Uuid

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         AppUser      @relation(fields: [userId], references: [id])
  location     Location?    @relation(fields: [locationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@index([userId, organisationId])
  @@index([organisationId, roleId])
  @@map("membership")
}

model DeviceSession {
  id         String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  deviceId   String         @map("device_id")
  platform   DevicePlatform
  pushToken  String?        @map("push_token")
  appVersion String?        @map("app_version")
  revokedAt  DateTime?      @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime?      @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId])
  @@map("device_session")
}

model SupportAccessGrant {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  supportUserId  String   @map("support_user_id") @db.Uuid
  approvedBy     String   @map("approved_by") @db.Uuid
  reason         String
  startsAt       DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime @map("ends_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organisationId, supportUserId, endsAt])
  @@map("support_access_grant")
}

model IdempotencyKey {
  organisationId String   @map("organisation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([organisationId, userId, key])
  @@map("idempotency_key")
}

model AuditLog {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  seq            BigInt    @default(0) // computed by trigger audit_log_chain
  occurredAt     DateTime  @default(dbgenerated("clock_timestamp()")) @map("occurred_at") @db.Timestamptz(6)
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  actorType      ActorType @default(USER) @map("actor_type")
  action         String
  entity         String
  entityId       String    @map("entity_id")
  beforeHash     String?   @map("before_hash")
  afterSummary   Json      @default("{}") @map("after_summary")
  ipHash         String?   @map("ip_hash")
  prevHash       String    @default("") @map("prev_hash") // computed by trigger
  hash           String    @default("") // computed by trigger

  @@unique([organisationId, seq])
  @@index([organisationId, entity, entityId])
  @@index([organisationId, actorUserId, occurredAt])
  @@map("audit_log")
}

model ServiceType {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  code           String
  name           String
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?   @map("updated_by") @db.Uuid

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, code])
  @@map("service_type")
}

model RegisteredActivity {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  locationId     String    @map("location_id") @db.Uuid
  code           String
  name           String
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?   @map("updated_by") @db.Uuid

  organisation Organisation @relation(fields: [organisationId], references: [id])
  location     Location     @relation(fields: [locationId], references: [id])

  @@unique([organisationId, locationId, code])
  @@index([organisationId, locationId])
  @@map("registered_activity")
}

// ---------------------------------------------------------------------------
// M2: requirements, evidence, alerts (migration 0004)
// ---------------------------------------------------------------------------
enum RequirementSubjectType {
  STAFF
  VEHICLE
  EQUIPMENT
  PREMISES
  SERVICE
  ORGANISATION

  @@map("requirement_subject_type")
}

enum TemplateVersionStatus {
  DRAFT
  APPROVED
  EFFECTIVE
  SUPERSEDED

  @@map("template_version_status")
}

enum RequirementBasis {
  STATUTORY
  REGULATORY_GUIDANCE
  ORG_POLICY
  GOOD_PRACTICE

  @@map("requirement_basis")
}

enum RequirementBlocking {
  NONE
  POLICY
  DEPLOYMENT_CRITICAL
  STATUTORY
  SAFETY_CRITICAL

  @@map("requirement_blocking")
}

enum Applicability {
  APPLICABLE
  APPROVED_NOT_APPLICABLE

  @@map("applicability")
}

enum RagStatus {
  RED
  AMBER
  GREEN
  GREY
  NOT_APPLICABLE

  @@map("rag_status")
}

enum ScanStatus {
  PENDING
  CLEAN
  MALICIOUS
  FAILED

  @@map("scan_status")
}

enum VerificationDecision {
  ACCEPTED
  REJECTED

  @@map("verification_decision")
}

enum AlertState {
  OPEN
  ACKNOWLEDGED
  RESOLVED

  @@map("alert_state")
}

enum AlertSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW

  @@map("alert_severity")
}

enum NotificationChannel {
  EMAIL
  IN_APP
  PUSH

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DEAD

  @@map("notification_status")
}

model RequirementTemplate {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  pack           String   @default("CUSTOM")
  code           String
  title          String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid

  versions  RequirementTemplateVersion[]
  instances RequirementInstance[]

  @@map("requirement_template")
}

model RequirementTemplateVersion {
  id                String                 @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId    String?                @map("organisation_id") @db.Uuid
  templateId        String                 @map("template_id") @db.Uuid
  version           Int
  status            TemplateVersionStatus  @default(DRAFT)
  basisType         RequirementBasis       @map("basis_type")
  regulationRef     String?                @map("regulation_ref")
  sourceUrl         String?                @map("source_url")
  sourceVersionDate DateTime?              @map("source_version_date") @db.Date
  effectiveFrom     DateTime?              @map("effective_from") @db.Date
  effectiveTo       DateTime?              @map("effective_to") @db.Date
  subjectType       RequirementSubjectType @map("subject_type")
  applicabilityRule Json                   @default("{}") @map("applicability_rule")
  evidenceType      String                 @default("DOCUMENT") @map("evidence_type")
  recurrence        Json
  warningDays       Int[]                  @default([90, 60, 30, 14, 7]) @map("warning_days")
  dueSoonDays       Int                    @default(30) @map("due_soon_days")
  blocking          RequirementBlocking    @default(NONE)
  approvalRole      String?                @map("approval_role")
  frameworkMappings Json                   @default("[]") @map("framework_mappings")
  deadlineKind      String                 @default("DUE") @map("deadline_kind")
  approvedBy        String?                @map("approved_by") @db.Uuid
  approvedAt        DateTime?              @map("approved_at") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?                @map("created_by") @db.Uuid

  template  RequirementTemplate   @relation(fields: [templateId], references: [id])
  instances RequirementInstance[]

  @@unique([templateId, version])
  @@map("requirement_template_version")
}

model RequirementInstance {
  id                String                 @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId    String                 @map("organisation_id") @db.Uuid
  locationId        String?                @map("location_id") @db.Uuid
  templateId        String                 @map("template_id") @db.Uuid
  templateVersionId String                 @map("template_version_id") @db.Uuid
  subjectType       RequirementSubjectType @map("subject_type")
  subjectId         String                 @map("subject_id") @db.Uuid
  ownerUserId       String?                @map("owner_user_id") @db.Uuid
  deputyUserId      String?                @map("deputy_user_id") @db.Uuid
  anchorDate        DateTime?              @map("anchor_date") @db.Date
  dueDate           DateTime?              @map("due_date") @db.Date
  expiryDate        DateTime?              @map("expiry_date") @db.Date
  reviewDate        DateTime?              @map("review_date") @db.Date
  applicability     Applicability          @default(APPLICABLE)
  criticalFailure   Boolean                @default(false) @map("critical_failure")
  status            RagStatus              @default(GREY)
  reasonCode        String                 @default("MISSING") @map("reason_code")
  reasonText        String                 @default("No verified evidence on record") @map("reason_text")
  effect            String                 @default("NONE")
  currentlyVerified Boolean                @default(false) @map("currently_verified")
  computedAt        DateTime?              @map("computed_at") @db.Timestamptz(6)
  version           Int                    @default(1)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?                @map("created_by") @db.Uuid
  updatedAt         DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?                @map("updated_by") @db.Uuid

  template        RequirementTemplate        @relation(fields: [templateId], references: [id])
  templateVersion RequirementTemplateVersion @relation(fields: [templateVersionId], references: [id])
  decisions       ApplicabilityDecision[]
  dateChanges     DueDateChange[]
  links           EvidenceLink[]

  @@unique([organisationId, templateId, subjectType, subjectId])
  @@index([organisationId, status, dueDate])
  @@map("requirement_instance")
}

model ApplicabilityDecision {
  id             String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId String        @map("organisation_id") @db.Uuid
  instanceId     String        @map("instance_id") @db.Uuid
  decision       Applicability
  reason         String
  reviewerId     String        @map("reviewer_id") @db.Uuid
  reviewDate     DateTime      @map("review_date") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  instance RequirementInstance @relation(fields: [instanceId], references: [id])

  @@map("applicability_decision")
}

model DueDateChange {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  instanceId     String    @map("instance_id") @db.Uuid
  field          String
  oldDate        DateTime? @map("old_date") @db.Date
  newDate        DateTime  @map("new_date") @db.Date
  reason         String
  approverId     String    @map("approver_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String    @map("created_by") @db.Uuid

  instance RequirementInstance @relation(fields: [instanceId], references: [id])

  @@map("due_date_change")
}

model EvidenceItem {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  title          String
  type           String   @default("DOCUMENT")
  retentionClass String   @default("STANDARD") @map("retention_class")
  sensitivity    String   @default("NORMAL")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String   @map("created_by") @db.Uuid

  versions EvidenceVersion[]
  links    EvidenceLink[]

  @@map("evidence_item")
}

model EvidenceVersion {
  id             String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId String     @map("organisation_id") @db.Uuid
  itemId         String     @map("item_id") @db.Uuid
  versionNo      Int        @default(1) @map("version_no")
  blobKey        String     @map("blob_key")
  declaredMime   String     @map("declared_mime")
  declaredSize   BigInt     @map("declared_size")
  mime           String?
  sizeBytes      BigInt?    @map("size_bytes")
  sha256         String?
  scanStatus     ScanStatus @default(PENDING) @map("scan_status")
  uploadedAt     DateTime?  @map("uploaded_at") @db.Timestamptz(6)
  scannedAt      DateTime?  @map("scanned_at") @db.Timestamptz(6)
  uploadedBy     String     @map("uploaded_by") @db.Uuid
  capturedAt     DateTime   @default(now()) @map("captured_at") @db.Timestamptz(6)
  validFrom      DateTime?  @map("valid_from") @db.Date
  validTo        DateTime?  @map("valid_to") @db.Date
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  item         EvidenceItem  @relation(fields: [itemId], references: [id])
  verification Verification?

  @@unique([itemId, versionNo])
  @@unique([organisationId, blobKey])
  @@map("evidence_version")
}

model EvidenceLink {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  instanceId     String   @map("instance_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String   @map("created_by") @db.Uuid

  item     EvidenceItem        @relation(fields: [itemId], references: [id])
  instance RequirementInstance @relation(fields: [instanceId], references: [id])

  @@unique([itemId, instanceId])
  @@map("evidence_link")
}

model Verification {
  id                String               @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId    String               @map("organisation_id") @db.Uuid
  evidenceVersionId String               @unique @map("evidence_version_id") @db.Uuid
  decision          VerificationDecision
  reason            String?
  reviewerId        String               @map("reviewer_id") @db.Uuid
  confirmedValidTo  DateTime?            @map("confirmed_valid_to") @db.Date
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  evidenceVersion EvidenceVersion @relation(fields: [evidenceVersionId], references: [id])

  @@map("verification")
}

model Alert {
  id             String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId String        @map("organisation_id") @db.Uuid
  sourceType     String        @map("source_type")
  sourceId       String        @map("source_id") @db.Uuid
  severity       AlertSeverity
  reasonCode     String        @map("reason_code")
  reasonText     String        @map("reason_text")
  ownerUserId    String?       @map("owner_user_id") @db.Uuid
  state          AlertState    @default(OPEN)
  snoozedUntil   DateTime?     @map("snoozed_until") @db.Timestamptz(6)
  acknowledgedBy String?       @map("acknowledged_by") @db.Uuid
  acknowledgedAt DateTime?     @map("acknowledged_at") @db.Timestamptz(6)
  raisedAt       DateTime      @default(now()) @map("raised_at") @db.Timestamptz(6)
  resolvedAt     DateTime?     @map("resolved_at") @db.Timestamptz(6)
  version        Int           @default(1)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  deliveries NotificationDelivery[]

  @@map("alert")
}

model NotificationDelivery {
  id              String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId  String              @map("organisation_id") @db.Uuid
  alertId         String              @map("alert_id") @db.Uuid
  channel         NotificationChannel
  recipientUserId String              @map("recipient_user_id") @db.Uuid
  dedupeKey       String              @map("dedupe_key")
  status          NotificationStatus  @default(PENDING)
  attempts        Int                 @default(0)
  nextAttemptAt   DateTime            @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  escalatedTo     String?             @map("escalated_to")
  lastError       String?             @map("last_error")
  sentAt          DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  alert Alert @relation(fields: [alertId], references: [id])

  @@unique([organisationId, dedupeKey])
  @@map("notification_delivery")
}

model StatusSnapshot {
  id             String                 @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organisationId String                 @map("organisation_id") @db.Uuid
  snapshotDate   DateTime               @map("snapshot_date") @db.Date
  subjectType    RequirementSubjectType @map("subject_type")
  counts         Json
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organisationId, snapshotDate, subjectType])
  @@map("status_snapshot")
}

// ---------------------------------------------------------------------------
// M3 staff (sql/migrations/0005_m3_staff.sql)
// ---------------------------------------------------------------------------
enum StaffLifecycle {
  CANDIDATE
  CHECKS_IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED_FOR_ROLE
  ACTIVE
  SUSPENDED
  LEAVER

  @@map("staff_lifecycle")
}

enum StaffRole {
  DRIVER
  CARE_ASSISTANT
  EMERGENCY_CARE_ASSISTANT
  TECHNICIAN
  PARAMEDIC
  NURSE
  CONTROL_ROOM
  MANAGER
  OTHER

  @@map("staff_role")
}

enum StaffRecordKind {
  REFERENCE
  DBS
  RIGHT_TO_WORK
  LICENCE
  REGISTRATION
  TRAINING
  COMPETENCY
  SUPERVISION
  APPRAISAL
  OBJECTIVE
  EMPLOYMENT_HISTORY
  INDUCTION
  PROBATION
  OH_CLEARANCE
  OH_DETAIL
  PERSONAL

  @@map("staff_record_kind")
}

enum StaffRestrictionType {

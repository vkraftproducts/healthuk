{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "DATABASE_ADMIN_URL"]
    },
    "dev:oidc": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "PRISMA_SCHEMA_ENGINE_BINARY",
    "PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING",
    "TEST_SUPERUSER_URL",
    "DATABASE_URL",
    "DATABASE_ADMIN_URL",
    "CI"
  ]
}
